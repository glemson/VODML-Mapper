<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.ivoa.net/xml/VO-DML_Mapper/v1.0" xmlns="http://www.ivoa.net/xml/VO-DML_Mapper/v1.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" attributeFormDefault="unqualified">

  <xsd:complexType name="Schema">
    <xsd:sequence>
      <xsd:element name="schema_name" type="xsd:string" />
      <xsd:element name="description" type="xsd:string" minOccurs="0"/>
      <xsd:element name="numTables" type="xsd:int" minOccurs="0"/>
      <xsd:element name="table" type="Table" minOccurs="0" maxOccurs="unbounded" />
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="Table">
    <xsd:sequence>
      <xsd:element name="table_name" type="xsd:string" />
      <xsd:element name="description" type="xsd:string" minOccurs="0" maxOccurs="1" />
      <xsd:element name="column" type="Column" minOccurs="0" maxOccurs="unbounded" />
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="Column">
    <xsd:sequence>
      <xsd:element name="column_name" type="xsd:string" />
      <xsd:element name="datatype" type="xsd:string" minOccurs="1" maxOccurs="1" />
      <xsd:element name="description" type="xsd:string" minOccurs="0" maxOccurs="1" />
      <xsd:element name="ucd" type="xsd:string" minOccurs="0" maxOccurs="1" />
      <xsd:element name="unit" type="xsd:string" minOccurs="0" maxOccurs="1" />
      <xsd:element name="size" type="xsd:string" minOccurs="0" maxOccurs="1" />
    </xsd:sequence>
  </xsd:complexType>

  <xsd:element name="TAP_SCHEMA">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="endpoint" type="xsd:anyURI" />
        <xsd:element name="schema" type="Schema" minOccurs="1" maxOccurs="unbounded" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="TAP_TABLE">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="endpoint" type="xsd:anyURI" />
        <xsd:element name="table_name" type="xsd:string" minOccurs="1" maxOccurs="1" />
        <xsd:element name="column" type="Column" minOccurs="0" maxOccurs="unbounded" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>


</xsd:schema>