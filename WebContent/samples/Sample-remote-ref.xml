<VOTABLE
    xmlns="http://www.ivoa.net/xml/VOTable/v1.4_vodml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.4_vodml http://volute.g-vo.org/svn/trunk/projects/dm/vo-dml/xsd/ext/VOTable-1.4_vodml.xsd">
    <VODML>
        <MODEL>
            <NAME>ivoa</NAME>
            <URL>http://volute.g-vo.org/svn/trunk/projects/dm/vo-dml/models/ivoa/vo-dml/IVOA-v1.0.vo-dml.xml</URL>
        </MODEL>
        <MODEL>
            <NAME>vo-dml</NAME>
            <URL>http://localhost:8080/VODML-Mapper/vo-dml/VO-DML.vo-dml.xml</URL>
        </MODEL>
        <MODEL>
            <NAME>filter</NAME>
            <URL>http://volute.g-vo.org/svn/trunk/projects/dm/vo-dml/models/sample/filter/vo-dml/Filter.vo-dml.xml</URL>
        </MODEL>
        <MODEL>
            <NAME>sample</NAME>
            <URL>http://volute.g-vo.org/svn/trunk/projects/dm/vo-dml/models/sample/sample/vo-dml/Sample.vo-dml.xml</URL>
        </MODEL>
        <GLOBALS>
            <INSTANCE dmtype="sample:catalog.SkyCoordinate">
                <ATTRIBUTE dmrole="sample:catalog.SkyCoordinate.longitude">
                    <INSTANCE dmtype="ivoa:RealQuantity">
                        <ATTRIBUTE dmrole="ivoa:Quantity.unit">
                            <LITERAL dmtype="ivoa:Unit" value="deg"/>
                        </ATTRIBUTE>
                        <ATTRIBUTE dmrole="ivoa:RealQuantity.value">
                            <LITERAL dmtype="ivoa:real" value="123"/>
                        </ATTRIBUTE>
                    </INSTANCE>
                </ATTRIBUTE>
                <ATTRIBUTE dmrole="sample:catalog.SkyCoordinate.latitude">
                    <INSTANCE dmtype="ivoa:RealQuantity">
                        <ATTRIBUTE dmrole="ivoa:Quantity.unit">
                            <LITERAL dmtype="ivoa:Unit" value="deg"/>
                        </ATTRIBUTE>
                        <ATTRIBUTE dmrole="ivoa:RealQuantity.value">
                            <LITERAL dmtype="ivoa:real" value="12"/>
                        </ATTRIBUTE>
                    </INSTANCE>
                </ATTRIBUTE>
                <REFERENCE dmrole="sample:catalog.SkyCoordinate.frame">
                    <REMOTEREFERENCE>http:/link.to.formal.rep.of.frame/ICRS</REMOTEREFERENCE>
                </REFERENCE>
            </INSTANCE>
        </GLOBALS>
    </VODML>
    <RESOURCE/>
</VOTABLE>